# secrets / personal config — real, owner-filled-in files, never shipped
# (the .example templates ARE committed)
.env
config.yaml

# personal campaign content (real outreach copy, not source/example data)
campaigns/

# python
.venv/
__pycache__/
*.pyc

# React dashboard frontend: node deps and the built bundle are generated, not
# source. `slap.py dashboard` fails loud with the build command if the bundle
# is missing (same convention as requiring .env/config.yaml first), so it's
# rebuilt via `npm --prefix slap/frontend run build`.
slap/frontend/node_modules/
slap/static/dist/

# probe outputs (raw captures are auditable but not committed)
probes/findings/

# tracking store (runtime data, not source)
slap.db
slap.db-journal
slap.db-wal
slap.db-shm

# template-reload's failure report (real recipient emails, runtime data)
template_reload_failures.json

# LaTeX compile workdirs (runtime staging, not source)
workdir/

# runner/sync logs (runtime output, not source)
runner.log
runner.err.log
sync.log
sync.err.log

# local marketing/screenshot mockups — real campaign names, never committed
marketing_dashboard_sample.html

# macOS
.DS_Store

# Claude Code tooling/config and internal build docs — kept local, not committed
.claude/
CONTROL_SHEET.md
SLAP_BUILD_PROMPT.md
CLAUDE.md

# prompt-store: Claude-Code-only prompt-builder layer (see prompt-store/CLAUDE.md).
# Everything else prompt-store/ ever holds — real per-recipient generation-prompt content
# and the symlinks into campaigns/<name>/prompt.md — is exactly as sensitive as campaigns/
# itself and must never be committed. Only the generic builder/workflow file is tracked.
prompt-store/*
!prompt-store/CLAUDE.md
