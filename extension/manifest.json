{
  "manifest_version": 3,
  "name": "slap",
  "version": "0.1.0",
  "description": "Capture job postings into slap, see prior contact, and record applications.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5050/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open slap on this page" },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
