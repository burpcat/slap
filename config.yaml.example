# Copy to config.yaml and fill in your own sender details.
# See SLAP_BUILD_PROMPT.md §4 for the full schema; slap/config.py enforces it.
sender:
  from_email: everythingforgenius@gmail.com
  from_name: <Owner Name>

# Used to fill {{signature}} in every campaign template — required (can be
# an empty string "" to send with no signature, but the key itself must be
# present; see slap/config.py's load_global_config).
signature: |-
  <Your Name>
  <link — e.g. LinkedIn>
  <link — e.g. GitHub or portfolio>

# Sending + reply detection go through Gmail directly (SMTP for sends, IMAP for
# replies) using a Gmail App Password in .env as GMAIL_APP_PASSWORD — there is
# no api key or `gmass:` block anymore. The sender/login is sender.from_email
# above; hosts are Gmail's fixed smtp.gmail.com:587 / imap.gmail.com:993.

personas: # cadences are FIXED per persona
  hiring_manager: { stages: [2, 4, 6] }
  recruiter: { stages: [2, 3, 5] }
  founder: { stages: [2, 5, 7] }

schedule:
  fire_window_start: "09:00" # runner rolls a random fire moment in this window
  fire_window_end: "09:15"
  send_delay_min: 10 # seconds between emails during a drain
  send_delay_max: 15
  daily_cap: 500 # Gmail ceiling; drain stops here, overflow re-queues
  drain_retries: 3 # transient-failure retries before surfacing run_failed
  active_days: [mon, tue, wed, thu, fri] # days the unattended runner may drain (skip weekends here)
  # Optional — new-recipient sends per rolling week. Drives the Analytics
  # page's weekly-goal-pacing gauge; omit entirely to hide that widget.
  # weekly_target: 20

tracking:
  consumer_domains_file: consumer_domains.txt

# Optional — folder holding every résumé PDF (defaults to "docs" if omitted).
# Replaces the old per-campaign campaigns/<name>/resume.pdf: each static
# (latex-off) campaign now references one or more of the send_tags below.
docs_dir: docs

# Optional — named résumé shortcuts: tag -> filename inside docs_dir. A campaign
# lists which tags it offers under `resumes:` in its campaign.yaml (first = the
# default); `slap.py send --resume <tag>` forces one from the command line and
# skips the interactive picker. A campaign that references an undefined tag fails
# loud. Hold as many résumés here as you like (e.g. fde.pdf, ds.pdf).
send_tags:
  default: resume.pdf
  # fde: fde.pdf
  # ds:  ds.pdf

# Optional — folder with the generation reference files (star.json, story.md, …)
# that the MCP server (slap_mcp.py) serves to Claude. Omit if you don't use MCP.
# references_dir: ~/path/to/reference-files


# Optional — application-form profile for the browser extension. It fills
# standard fields from this, always after you review every value. It never
# fills passwords, payment or government-ID fields, or EEO self-identification
# questions; you answer those yourself.
profile:
  # Matched to form labels by name (first name, email, current company, ...).
  fields:
    first_name: Ada
    last_name: Lovelace
    email: ada@example.com
    phone: "+1 555 0100"
    linkedin: https://www.linkedin.com/in/example/
    github: https://github.com/example
    website: https://example.com
    location: Boston, MA
    current_company: Example Corp
    current_title: Software Engineer
    work_authorization: "Yes"     # "Are you legally authorized to work in ...?"
    sponsorship: "No"             # "Will you now or in the future require sponsorship?"
    resume_filename: Ada_Lovelace_Resume.pdf   # name the uploaded résumé gets (default: <tag>.pdf)

  # Answer bank: `match` is a case-insensitive regex tested against the question's
  # label. First match wins. Claude Code can generate these from star.json; keep
  # every claim inside what star.json supports.
  answers:
    - match: "notice period|earliest start|when can you start"
      answer: "Two weeks from offer."
    - match: "how did you hear"
      answer: "Company careers page."

# Optional — the command `slap.py send custom` (and `remind --new`) uses to open
# a scratch file for authoring. Defaults to "code --wait" if omitted. Use a FULL
# command: GUI editors need a blocking flag (VS Code: `code --wait`, Sublime:
# `subl --wait`) so slap waits for you to close the file before reading it back;
# terminal editors block natively (`vim`, `nvim`, `nano`). `doctor` verifies the
# binary is on PATH but never blocks a send/drain over it.
editor: "code --wait"

# Optional — entirely omittable. Caches GMass reply/click/bounce data for
# the dashboard, refreshed hourly by `slap.py sync` (see LAUNCHD.md) instead
# of on every page load. If this block (or Redis itself) isn't there, the
# dashboard just falls back to live polling on open, exactly like before —
# `doctor` reports whether Redis is actually reachable, but never blocks a
# send/drain over it either way.
redis:
  url: redis://localhost:6379/0
