# Copy to profile.yaml (gitignored). The slap browser extension fills
# application forms from this, after you review every value. It never fills
# passwords, payment or government-ID fields, or EEO self-identification
# questions; you answer those yourself.

# Standard fields, matched to form labels by name (first name, email, phone, ...).
fields:
  first_name: Ada
  last_name: Lovelace
  email: ada@example.com
  phone: "+1 555 0100"
  linkedin: https://www.linkedin.com/in/example/
  github: https://github.com/example
  website: https://example.com
  location: Boston, MA
  work_authorization: "Yes"     # "Are you legally authorized to work in ...?"
  sponsorship: "No"             # "Will you now or in the future require sponsorship?"
  resume_filename: Ada_Lovelace_Resume.pdf   # name the uploaded résumé gets (default: <tag>.pdf)

# Answer bank: `match` is a case-insensitive regex tested against the question's
# label. First match wins. Claude Code can generate these from star.json; keep
# every claim inside what star.json supports.
answers:
  - match: "notice period|earliest start|when can you start"
    answer: "Two weeks from offer."
  - match: "how did you hear"
    answer: "Company careers page."
